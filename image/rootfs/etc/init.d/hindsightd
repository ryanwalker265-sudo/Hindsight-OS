#!/sbin/openrc-run

name="hindsightd"
description="Hindsight app storage and Rewind snapshots"
supervisor=supervise-daemon
command=/usr/bin/hindsightd
output_log=/var/log/hindsight/hindsightd.log
error_log=/var/log/hindsight/hindsightd.log
respawn_delay=2

depend() {
	need localmount
	after bootmisc
}

start_pre() {
	checkpath -d -m 0755 /var/lib/hindsight
	checkpath -d -m 0755 /var/log/hindsight
}
