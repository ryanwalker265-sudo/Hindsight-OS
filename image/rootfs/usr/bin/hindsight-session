#!/bin/sh
# Show the phone interface on the screen: the cage kiosk compositor running
# Chromium in app mode, pointed at hindsightd.
export HOME=/home/hindsight
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WLR_RENDERER=pixman          # software rendering works on every emulator
export WLR_NO_HARDWARE_CURSORS=1
export LIBSEAT_BACKEND=seatd

URL=http://127.0.0.1:7070/
BROWSER=$(command -v chromium || command -v chromium-browser)

# Wait (up to 2 minutes) for hindsightd to answer.
i=0
while [ $i -lt 240 ] && ! wget -q -O /dev/null "${URL}api/system"; do
  i=$((i + 1))
  sleep 0.5
done

exec cage -d -- "$BROWSER" \
  --ozone-platform=wayland \
  --kiosk --app="$URL" \
  --disable-gpu \
  --force-device-scale-factor=1 \
  --no-first-run --no-default-browser-check \
  --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
  --disable-features=Translate,MediaRouter,OptimizationHints \
  --disable-component-update --disable-background-networking \
  --overscroll-history-navigation=0 --disable-pinch \
  --password-store=basic \
  --user-data-dir="$HOME/.local/share/hindsight-browser"
